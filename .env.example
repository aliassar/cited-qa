# Copy to .env for local development:  cp .env.example .env
# NEVER commit the real .env - it is in .gitignore for a reason.

ENVIRONMENT=local
DEBUG=true

# --- database -----------------------------------------------------------
# SQLite needs no infrastructure and is the default.
DATABASE_URL=sqlite+aiosqlite:///./cited_qa.db
# Postgres (what docker-compose uses). Note the +asyncpg driver - a plain
# postgresql:// URL loads psycopg2, which is SYNCHRONOUS and will block the
# event loop on every query.
# DATABASE_URL=postgresql+asyncpg://citedqa:citedqa@localhost:5432/citedqa

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# --- security -----------------------------------------------------------
# Generate a real one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
BCRYPT_ROUNDS=12

# JSON array - pydantic-settings parses list fields as JSON.
CORS_ALLOW_ORIGINS=["http://localhost:5173"]

# --- rate limiting ------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# --- llm ----------------------------------------------------------------
# "fake" runs a deterministic local stub - no key, no network, no cost.
LLM_PROVIDER=fake
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-opus-5-5
LLM_MAX_TOKENS=4096

# --- background ingestion ----------------------------------------------
INGEST_WORKER_COUNT=2
INGEST_QUEUE_MAXSIZE=1000
